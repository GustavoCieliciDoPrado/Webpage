.mainb{
    background-image: url("background.png");
    background-blend-mode: overlay;
    position: relative;
}
.header{
    background-color: rgba(255, 255, 255, 0.7);
    padding: 20;
    margin-top: -15px;
    margin-left: -10px;
    margin-right: -10px;
}
a.heading{
    font-size: xx-large;
    text-align: center;
    display: inline;
    float:right;
    position:sticky;
    margin-right: 60%;
    margin-top: -10px;
}
.dropbtn{
    color: black;
    background-color: rgba(255, 255, 255, 0.7);
    border: none;
    padding: 20px;
    border-radius: 10px;
    align-self: center;
}

.dropdown{
    position: relative;
    display: inline-block;
    
}

.dropdown-content {
    display: none;
    position: absolute;
    background-color: rgb(241, 241, 241, 0.8);
    min-width: 160px;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
    z-index: 1;
  }

  .dropdown-content a {
    color: black;
    padding: 12px 16px;
    text-decoration: none;
    display: block;
  }



  .dropdown:hover .dropdown-content {display: block;}
